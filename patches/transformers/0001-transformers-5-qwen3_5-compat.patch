+
+def _local_parquet_files(
+    path: str, name: Optional[str], split: Optional[str]
+) -> Optional[List[str]]:
+    """Local shards for (path, name, split) under $ULTRAVOX_LOCAL_HF_CACHE (a HF hub cache dir), else None."""
+    root = os.environ.get("ULTRAVOX_LOCAL_HF_CACHE")
+    if not root or not split:
+        return None
+    snaps = sorted(
+        glob.glob(
+            os.path.join(root, "datasets--" + path.replace("/", "--"), "snapshots", "*")
+        )
+    )
+    if not snaps:
+        return None
+    files = sorted(glob.glob(os.path.join(snaps[-1], name or "", f"{split}-*.parquet")))
+    if not files and os.environ.get("RANK", "0") != "0":
+        return None  # only rank 0 reads data; other ranks fall back to the Hub path (metadata only)
+    if not files:
+        raise FileNotFoundError(
+            f"ULTRAVOX_LOCAL_HF_CACHE set but no local shards for {path}/{name}/{split}"
+        )
+    return files
+
